    <string name="rules_moves_title">Pawn Movement</string>
    <string name="rules_moves_desc">On your turn, you can move your pawn one square horizontally or vertically (no diagonals). If facing the opponent pawn, you can jump over it!</string>
    <string name="rules_walls_title">Wall Placement</string>
    <string name="rules_walls_desc">Instead of moving, you can place a 2-unit long wall horizontally or vertically to block or detour your opponent. You cannot completely seal off a player\'s path to their goal.</string>
